# DOTARENA — переменные окружения
# Скопируй в .env и заполни

# Telegram
BOT_TOKEN=ВАШ_ТОКЕН_ОТ_BOTFATHER

# База данных (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dotarena

# Кэш (Redis)
REDIS_URL=redis://localhost:6379/0

# Публичный URL для Webhook и TMA (Cloudflare Tunnel или домен)
# Для локальной разработки: запускаешь cloudflared tunnel --url http://localhost:5173
# и копируешь ссылку сюда
PUBLIC_URL=https://random-name.trycloudflare.com

# OpenDota (опционально — если есть ключ API)
# Без ключа: 2000 запросов/день, 60/мин
# С ключом: лимиты выше
# OPEN_DOTA_KEY=

# Режим разработки
DEBUG=true

# Сервер
HOST=0.0.0.0
PORT=8000
